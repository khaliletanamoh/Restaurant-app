rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.get('role', 'customer'); }
    function isStaff() { return signedIn() && role() in ['staff', 'manager']; }
    function isManager() { return signedIn() && role() == 'manager'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid) && request.resource.data.loyaltyPoints == 0;
      // Customers can never change their own points.
      allow update: if isOwner(uid)
                    && request.resource.data.loyaltyPoints == resource.data.loyaltyPoints;
    }

    match /menuCategories/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /menuItems/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    match /tables/{id} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    match /orders/{id} {
      allow read: if isOwner(resource.data.userId) || isStaff();

      // Customers create their own order as pending. Totals are corrected by Cloud Functions.
      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50;

      allow update: if (isStaff() && onlyChanges(['status', 'updatedAt']))
                    || (isOwner(resource.data.userId)
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'cancelled'
                        && onlyChanges(['status', 'updatedAt']));
    }

    match /reservations/{id} {
      allow read: if isOwner(resource.data.userId) || isStaff();

      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.partySize is int
                    && request.resource.data.partySize >= 1
                    && request.resource.data.partySize <= 30;

      allow update: if (isStaff() && onlyChanges(['status', 'updatedAt']))
                    || (isOwner(resource.data.userId)
                        && request.resource.data.status == 'cancelled'
                        && onlyChanges(['status', 'updatedAt']));
    }

    match /loyaltyTransactions/{id} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow write: if false; // Cloud Functions only
    }

    match /dailyStats/{id} {
      allow read: if isManager();
      allow write: if false; // Cloud Functions only
    }
  }
}
